Algoritmo Meses
	Definir mes Como Entero
	Escribir Sin Saltar "Dime un número del 1 al 12: "
	Leer mes
	Segun mes Hacer
		1:
			Escribir "ENERO: 31 días"
		2:
			Escribir "FEBRERO: 28 (Si es año bisiesto 29)días"
		3:
			Escribir "MARZO: 31d días"
		4:
			Escribir "ABRIL: 30 días"
		5: 
			Escribir "MAYO: 31 días"
		6: 
			Escribir "JUNIO: 30 días"
		7:
			Escribir "JULIO: 31 días"
		8:
			Escribir "AGOSTO: 31 días"
		9: 
			Escribir "SEPTIEMBRE: 30 días"
		10:
			Escribir "OCTUBRE: 31 días"
		11:	
			Escribir "NOVIEMBRE: 30 días"
		12:
			Escribir "DICIEMBRE: 31 días"
		De Otro Modo:
			Escribir "DIGITE UN NUMERO ENTRE EL 1 Y EL 12"
	Fin Segun
FinAlgoritmo
